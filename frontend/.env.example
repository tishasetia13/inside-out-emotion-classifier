# Copy this file to ".env" (never commit the real one) and adjust the values.
# Vite only exposes variables that start with VITE_ to the browser code.

# Base URL of the emotion API (no trailing slash needed).
VITE_API_BASE_URL=https://tishasetia13-inside-out-api.hf.space

# Set to "true" to use fake, local predictions instead of calling the API.
# You can also add ?mock=1 to the page URL (see README for ?mock=slow and ?mock=error).
VITE_USE_MOCK=false

# Public address of the deployed site. Used only for the social preview image
# URLs in index.html. Leave empty during local development.
VITE_SITE_URL=
